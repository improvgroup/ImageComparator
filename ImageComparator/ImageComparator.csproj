<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>Image Comparator</AssemblyTitle>
    <AssemblyName>ImageComparator</AssemblyName>
    <RootNamespace>ImageComparator</RootNamespace>
    <Product>Image Comparator</Product>
    <Company>Visible Reality, LLC</Company>
    <Copyright>Copyright © Visible Reality, LLC 2010</Copyright>
    <Version>1.0.1.1</Version>
    <AssemblyVersion>1.0.1.1</AssemblyVersion>
    <FileVersion>1.0.1.1</FileVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.11" />
  </ItemGroup>

</Project>
